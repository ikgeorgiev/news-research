# Review against the active Windows settings before cutover. No credentials here.
# The compose layout supplies paths, DB URL, CORS and the collection switch.
# SOURCE_* below preserve the currently approved source mix, not candidate feeds.
SOURCE_ENABLE_YAHOO=true
SOURCE_ENABLE_PRN=true
SOURCE_ENABLE_GN=true
SOURCE_ENABLE_BW=true
SOURCE_ENABLE_FINANCIALCONTENT=true
GUGGENHEIM_ISSUER_FEED_START=2026-11-09T08:00:00Z
RESEARCH_TIMING_LOG_UNTIL=2026-11-06T22:00:00Z
# Generate a separate server admin key; /admin is never exposed by the proxy.
ADMIN_API_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
# Copy existing VAPID keys securely only if retaining push configuration.
# Push subscriptions are origin-specific and require a real browser test.
