# Copy OUTSIDE the repository, chmod 600. Never commit populated secrets.
# Use a generated hexadecimal password (at least 32 characters): no URL escaping.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
PUBLIC_ORIGIN=https://news.example.com
SITE_ADDRESS=news.example.com
ACME_EMAIL=owner@example.com
READER_USERNAME=ivan
# Single quotes prevent Compose from expanding dollar signs inside bcrypt hashes.
READER_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
APP_ENV_FILE=/etc/cef-news/application.env
# Keep false for staging, restore and smoke testing. One collector at cutover.
ENABLE_COLLECTION=false
CADDY_PRIVATE_IP=172.30.82.2
INGRESS_SUBNET=172.30.82.0/24
INGRESS_IP_RANGE=172.30.82.128/25
