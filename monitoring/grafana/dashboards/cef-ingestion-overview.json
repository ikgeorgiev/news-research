        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.code AS source, r.feed_url, r.started_at, r.finished_at, r.status, r.items_seen, r.items_inserted, r.error_text FROM ingestion_runs r JOIN sources s ON s.id = r.source_id WHERE r.started_at >= NOW() - INTERVAL '24 hours' ORDER BY r.started_at DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Latest Feed Runs",
      "type": "table"
